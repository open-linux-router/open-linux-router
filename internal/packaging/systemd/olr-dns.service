[Unit]
Description=open-linux-router DNS resolver (unbound)
Documentation=man:unbound(8)
After=network.target

# Deliberately no Conflicts=unbound.service.
#
# This is a second, separate unbound instance, and it does not even want the
# same socket: olr's own relay owns :53 and this one answers on 127.0.0.1:5353.
# The distro's unbound.service and /etc/unbound belong to whatever the operator
# installed unbound for, and taking them over would be squatting shared state
# (design.md §3.4). The two can run side by side without either noticing.

[Service]
Type=simple

# The root trust anchor, bootstrapped before unbound needs it.
#
# The leading `-` is not laziness: unbound-anchor exits non-zero when it
# *updated* the key, which is the ordinary case, and it falls back to a built-in
# copy when the network is not up yet. Treating either as a failure would mean a
# box that cannot reach the internet also cannot resolve locally — the worst
# possible time to refuse to start.
#
# The anchor is ours rather than /var/lib/unbound's because unbound rewrites it
# as the root KSK rolls, and writing into the distro package's state directory
# is exactly the interference §3.4 forbids.
ExecStartPre=-/usr/sbin/unbound-anchor -a /var/lib/open-linux-router/dns/root.key

# Fail fast and legibly on a config unbound will not accept, rather than
# flapping under Restart=on-failure with the reason buried in the journal.
#
# This is also the *only* place the rendered config is syntax-checked: olrd
# executes no subprocesses (design.md §3.6), so it cannot run unbound-checkconf
# itself before writing.
ExecStartPre=/usr/sbin/unbound-checkconf /etc/open-linux-router/rendered/dns/unbound.conf

# -d keeps unbound in the foreground so systemd supervises the real process
# rather than a pid file. -p suppresses the pid file entirely.
#
# The paths are Debian's, because the package depends on unbound and that is
# where Debian puts it. On a distribution that puts it elsewhere, override just
# these lines rather than editing the unit:
#
#   /etc/systemd/system/olr-dns.service.d/10-path.conf
#     [Service]
#     ExecStartPre=
#     ExecStart=
#     ExecStart=/usr/bin/unbound -d -p -c /etc/open-linux-router/rendered/dns/unbound.conf
ExecStart=/usr/sbin/unbound -d -p -c /etc/open-linux-router/rendered/dns/unbound.conf

# SIGHUP makes unbound re-read its configuration and flush the cache. The flush
# is the load-bearing half: changing a forwarder while the old answers are still
# cached would leave the box resolving through the previous upstream for as long
# as those entries live.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2

# No sandbox, and root. See "Privileges" in design.md §3.5 for the decision this
# unit is one instance of.
#
# This is the unit that bought the decision. It ran under DynamicUser=yes with
# an empty capability set and thirteen restrictions, including
#
#   RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
#
# and unbound never started once on Debian 13, because unbound resolves its
# `interface:` lines through getifaddrs() — a netlink socket — even when every
# interface named is a literal address. The filter returned EAFNOSUPPORT,
# unbound-checkconf reported "could not resolve interface names", and the unit
# sat in an auto-restart loop while the rendered config it was rejecting was
# perfectly valid. Nothing in the error pointed at the sandbox.
#
# The rendered config still sets `username: ""` and `chroot: ""`, so unbound
# does not drop privileges either: one process identity, and a failure that
# means what it says.

# The trust anchor, which unbound rewrites as the root key rolls.
# StateDirectory= and not ReadWritePaths=: systemd refuses to start a unit whose
# ReadWritePaths= target does not exist, and at boot this unit can legitimately
# run before olr has ever applied anything and created it. StateDirectory= makes
# systemd create it instead, so the unit is self-sufficient.
#
# Running as root also puts this back at /var/lib/open-linux-router/dns. Under
# DynamicUser systemd kept it in /var/lib/private and left a symlink, which is
# why an upgrading box logs one "migrating" line and then stops mentioning it.
StateDirectory=open-linux-router/dns
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
