[Unit]
Description=open-linux-router control plane
Documentation=https://github.com/open-linux-router/open-linux-router
After=network-pre.target
Wants=network-pre.target

# Deliberately no Requires= or After= on any backend unit.
#
# olrd supervises olr-dhcp.service rather than depending on it, and the
# dependency must not be inverted: design.md §3.5 requires that restarting olrd
# never drops a packet or expires a lease. An After=olr-dhcp.service would make
# the backend's state a precondition of the control plane starting, which is
# exactly backwards — the backend has to keep serving while olrd is stopped.

[Service]
Type=notify
NotifyAccess=main

# Where `olr daemon listen` writes, and the only supported way to give olrd
# arguments. Editing this unit would work too and would be overwritten by the
# next upgrade, which is the whole reason for the indirection.
#
# The leading `-` makes a missing file not an error: the tarball install and a
# hand-built box may not have one, and olrd's defaults are a working
# configuration.
EnvironmentFile=-/etc/open-linux-router/olrd.env

# $OLRD_ARGS unbraced, which systemd word-splits — ${OLRD_ARGS} would pass
# "--listen 0.0.0.0:8080" as a single argument and olrd would reject it.
ExecStart=/usr/bin/olr internal daemon $OLRD_ARGS
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2

# The sandbox from design.md §3.6, which is affordable because olrd speaks
# nftables and netlink directly and systemd over D-Bus rather than shelling out.
# There is no exec.Command("nft") and no exec.Command("systemctl"), and the
# first exec added to olrd silently costs most of what is below, so this block
# is a standing constraint on the code, not decoration.
#
# The one command olrd does run is the distribution's package manager, when an
# operator presses the button that clears a missing-backend blocker — and it is
# run as a *transient systemd unit* (internal/core/install.go), which PID 1
# spawns outside this namespace. That is not a workaround; it is the only shape
# that keeps ProtectSystem=strict, because an apt-get inside this sandbox cannot
# write /var/lib/dpkg and the alternative was an apt-shaped hole in the block
# below, permanently.
#
# Deliberately no CapabilityBoundingSet. It used to read
#
#   CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
#
# which looked like defence in depth and was not. olrd holds a root connection
# to systemd's private bus — it has to, that is how it drives the backends —
# and StartTransientUnit over that bus runs anything with the full capability
# set systemd grants. The bounding set could never contain an attacker who had
# already reached olrd's address space, because the escape hatch is a feature
# we cannot remove.
#
# What it did contain was us. core.holderOf answers "who is already serving
# DNS" by matching a socket inode against /proc/<pid>/fd, which needs
# CAP_SYS_PTRACE the moment the holder runs as its own user — and dnsmasq,
# unbound and systemd-resolved all do. So the one branch that could name the
# incumbent was unreachable in production, every real conflict fell through to
# a fallback that guesses systemd-resolved, and operators were sent to edit a
# file for a package they did not have. A boundary that stops only the people
# maintaining it is not a boundary.
#
# The directives below stay, and are not the same bet. They constrain what a
# *bug* in olrd can reach — a mistyped path writing outside /etc/open-linux-router
# fails loudly here instead of quietly corrupting the box — which is worth
# having and costs nothing, because olrd never legitimately wants any of it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# AF_NETLINK for link/firewall, AF_UNIX for the control socket and D-Bus,
# AF_INET/AF_INET6 for the optional TCP listener.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# The only paths olrd writes: module configuration, its own state, and the
# runtime directory holding the control socket and the §5.5 guard snapshots.
#
# /etc/systemd is the fourth, and it is exactly one file: the drop-in that tells
# systemd-resolved to stop listening on :53 while it keeps resolving for this box
# (core.resolvedDropIn). design.md §3.6's own test for a restriction is whether
# it would ever stop code we intend to write — this one now does, and widening it
# by one directory is the sanctioned answer rather than quietly working around
# it. The leading `-` keeps a box without the directory from failing to start.
ReadWritePaths=/etc/open-linux-router /var/lib/open-linux-router -/etc/systemd
StateDirectory=open-linux-router
RuntimeDirectory=olr
RuntimeDirectoryMode=0755

# /run/olr is cleared on stop, but the guard snapshots under it are meant to be
# lost on reboot anyway (§5.5): a box that came back up is reachable by
# definition, so replaying an expired guard would revert a change that was fine.

[Install]
WantedBy=multi-user.target
