[Unit]
Description=open-linux-router control plane
Documentation=https://github.com/open-linux-router/open-linux-router
After=network-pre.target
Wants=network-pre.target

# Deliberately no Requires= or After= on any backend unit.
#
# olrd supervises olr-dhcp.service rather than depending on it, and the
# dependency must not be inverted: design.md §3.5 requires that restarting olrd
# never drops a packet or expires a lease. An After=olr-dhcp.service would make
# the backend's state a precondition of the control plane starting, which is
# exactly backwards — the backend has to keep serving while olrd is stopped.

[Service]
Type=notify
NotifyAccess=main

# Where `olr daemon listen` writes, and the only supported way to give olrd
# arguments. Editing this unit would work too and would be overwritten by the
# next upgrade, which is the whole reason for the indirection.
#
# The leading `-` makes a missing file not an error: the tarball install and a
# hand-built box may not have one, and olrd's defaults are a working
# configuration.
EnvironmentFile=-/etc/open-linux-router/olrd.env

# $OLRD_ARGS unbraced, which systemd word-splits — ${OLRD_ARGS} would pass
# "--listen 0.0.0.0:8080" as a single argument and olrd would reject it.
ExecStart=/usr/bin/olr internal daemon $OLRD_ARGS
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2

# No sandbox, and root — see "Privileges" in design.md §3.5.
#
# This block used to carry twelve hardening directives and a long argument for
# each. Two things ended it. The smaller: the list had already started growing
# holes that were not exceptions but corrections — ReadWritePaths= widened to
# /etc/systemd for one drop-in, CapabilityBoundingSet= deleted outright once it
# turned out to block core.holderOf from naming who holds :53 while containing
# no attacker, since olrd's own D-Bus connection to PID 1 can start a transient
# unit with any capability systemd grants.
#
# The larger: it kept breaking things a long way from here, in ways that never
# said "sandbox". A resolver that would not start on a valid config. A proxy
# that could not reach its certificate authority. Each one cost a debugging
# session and none of them was a security event.
#
# The one command olrd runs — the distribution's package manager, behind the
# button that clears a missing-backend blocker — still goes through a transient
# systemd unit (internal/core/install.go). That path is no longer load-bearing
# for ProtectSystem=, but it is still the right shape: apt's own output belongs
# in a unit of its own, and it is what makes the step legible in the journal.
#
# What remains below is not confinement. StateDirectory= and RuntimeDirectory=
# are there because systemd creating a directory is better than olrd racing to.
StateDirectory=open-linux-router
RuntimeDirectory=olr
RuntimeDirectoryMode=0755

# Kept across a stop, because /run/olr is not only olrd's. The backends' runtime
# directories — olr/dns, olr/dhcp — live under it, and systemd clears a
# RuntimeDirectory recursively. Without this, every restart of olrd (every
# upgrade) unlinked the running relay's observe socket out from under it: DNS
# kept answering, and the query log went silently empty until olr-dnsd happened
# to restart. That is the backend depending on olrd's lifecycle, which §3.5
# forbids.
#
# It is also what the §5.5 guard needs: a snapshot that is meant to survive olrd
# crashing cannot live in a directory olrd's own stop deletes. /run is still
# cleared on reboot, which is the only lifetime a snapshot should have — a box
# that came back up is reachable by definition. A socket left behind is cleared
# by core.ListenUnix on the next start.
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
